{
  "name": "zayush-pdd",
  "version": "0.1.0",
  "private": true,
  "description": "Заюш ПДД — Telegram Mini App для изучения ПДД РФ",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @zayush/api",
    "dev:web": "npm run dev -w @zayush/web",
    "dev:bot": "npm run dev -w @zayush/bot",
    "build": "npm run build -w @zayush/shared && npm run build -w @zayush/bot && npm run build -w @zayush/api && npm run build -w @zayush/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "npm run seed -w @zayush/api",
    "content:import": "npm run content:import -w @zayush/api --",
    "start": "npm run start -w @zayush/api",
    "licenses": "node scripts/gen-licenses.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "prisma": "7.10.1",
    "dotenv": "^17.2.3"
  }
}
