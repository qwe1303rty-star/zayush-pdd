# ─────────────────────────────────────────────────────────────
# Заюш ПДД — шаблон переменных окружения.
# Скопируйте в .env и заполните. НИКОГДА не коммитьте .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development            # development | production
PORT=8080
DATABASE_URL=postgresql://zayush:CHANGE_ME@localhost:5432/zayush

# HTTPS-адрес, по которому открывается Mini App (Telegram требует HTTPS)
WEBAPP_URL=https://your-domain.example
# Адрес API для webhook, если отличается от WEBAPP_URL (обычно пусто — один домен)
PUBLIC_API_URL=

# Токен бота от @BotFather. Только сервер! Не попадает в клиентскую сборку.
BOT_TOKEN=
# off | polling | webhook
BOT_MODE=off
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (16+ символов, A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=
# Сколько секунд initData считается свежей
INITDATA_MAX_AGE_SEC=86400

# Админы: Telegram ID через запятую (узнать свой ID можно у @userinfobot)
ADMIN_TELEGRAM_IDS=
# Токен для входа в /admin из обычного браузера (32+ символа в production). Пусто — вход только из Telegram.
ADMIN_API_TOKEN=

# Только для локальной разработки вне Telegram. В production приложение не запустится с true.
DEV_AUTH_BYPASS=false

# ── Обязательная подписка (опционально) ──
# Источники разделяются «;», поля — «|»:  chatId|ссылка|Название
# chatId — @username публичного чата или числовой id (-100…) закрытого.
# Для закрытых чатов обязательно укажите ссылку-приглашение.
REQUIRE_SUBSCRIPTION=false
REQUIRED_CHANNELS=
REQUIRED_GROUPS=
# Пример:
# REQUIRED_CHANNELS=@zayush_channel||Канал Заюша
# REQUIRED_GROUPS=-1001234567890|https://t.me/+AbCdEfGh|Чат Заюша
SUBSCRIPTION_TTL_MIN=15
SUBSCRIPTION_GRACE_HOURS=24

# ── Напоминания от бота ──
REMINDERS_ENABLED=false
REMINDER_HOUR_MSK=19

# ── Файлы ──
UPLOAD_DIR=./uploads
# Путь к собранному фронтенду (production: API раздаёт Mini App с того же домена)
WEB_DIST_DIR=
# Если фронтенд на другом домене — разрешённые Origin через запятую
CORS_ORIGINS=

# ── AI-помощник (опционально, по умолчанию выключен) ──
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# ВНИМАНИЕ: при AI_PROVIDER=anthropic текст вопросов уходит за рубеж (трансграничная передача) —
# это отражается в политике автоматически, но нужно уведомление в Роскомнадзор.

# ── Оператор персональных данных (152-ФЗ) — обязательно для NODE_ENV=production ──
# Подставляется в /legal/privacy, /legal/consent, /legal/terms. Подробности — docs/legal.md
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
LEGAL_OPERATOR_OGRN=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_DOCS_DATE=23.10.2026
# Где стоят серверы с БД. Для граждан РФ — только Российская Федерация (ч. 5 ст. 18 152-ФЗ)
LEGAL_SERVER_LOCATION=Российская Федерация
# Секрет для обезличенных хэшей (журнал согласий, телефон). Сгенерируйте: openssl rand -hex 32
PD_HASH_SECRET=
# Автоудаление аккаунтов без входа N дней (0 — выключено)
RETENTION_INACTIVE_DAYS=1095

# ── Вход российским способом (149-ФЗ, ч. 10 ст. 8; штрафы — ст. 13.55 КоАП с 07.07.2026) ──
# true — после согласия пользователь подтверждает российский номер по SMS
AUTH_RU_PHONE_REQUIRED=false
# console — код пишется в лог (только разработка), smsru — https://sms.ru
SMS_PROVIDER=console
SMSRU_API_ID=
