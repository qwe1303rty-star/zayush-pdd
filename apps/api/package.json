{
  "name": "@zayush/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env scripts/import-content.ts --demo",
    "content:import": "tsx --env-file-if-exists=../../.env scripts/import-content.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@zayush/bot": "0.1.0",
    "@zayush/shared": "0.1.0",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
